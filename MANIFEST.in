include README.md INSTALL.md ROADMAP.MD CHANGELOG.md LICENSE
include REQUIREMENTS.md AGENTS.md AGENTS-MAINTENANCE.md
recursive-include docs *.md
recursive-include examples *.py *.md
recursive-include tests *.py
recursive-include scripts *.py
global-exclude *.py[cod]
prune .venv
prune .git
prune .uaml-local
prune build
prune dist
